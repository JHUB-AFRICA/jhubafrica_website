# API SERVER
NODE_ENV=development
PORT=4000
API_VERSION=v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://jhubafrica.com,https://www.jhubafrica.com

# DATABASE (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# JWT AUTHENTICATION
JWT_SECRET=your-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key
REFRESH_TOKEN_EXPIRES_IN=30d

# CACHING (Optional Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# EMAIL SERVICE (Resend)
# ==============================================================================
# In local development without a verified domain:
# - Leave RESEND_API_KEY set or unset (missing key runs in simulated logging mode)
# - EMAIL_FROM can stay onboarding@resend.dev (system automatically handles sandbox limits)
# In production with a verified domain:
# - EMAIL_FROM=JHUB Africa <notifications@jhubafrica.com>
# - Verify DNS records (SPF, DKIM, DMARC) in Resend dashboard
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=jhub Africa <onboarding@resend.dev>
EMAIL_REPLY_TO=inquiries@jhubafrica.com
EMAIL_TO=inquiries@jhubafrica.com

# Departmental Lead Routing (Optional - falls back to EMAIL_TO if unset)
EMAIL_INNOVATIONS=innovations@jhubafrica.com
EMAIL_COURSES=training@jhubafrica.com
EMAIL_PARTNERSHIPS=partnerships@jhubafrica.com
EMAIL_EVENTS=events@jhubafrica.com

# STORAGE (Optional Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
